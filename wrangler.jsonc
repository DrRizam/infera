// wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infera",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "infera-app.com", "custom_domain": true },
    { "pattern": "www.infera-app.com", "custom_domain": true }
  ]
}
